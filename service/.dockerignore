# Secrets — keep these at the top. `.env` is gitignored but the Dockerfile
# does `COPY . .` in the builder stage; without these excludes the real
# bearer token in `.env` would be baked into the builder layer (b.bm8).
.env
.env.*
*.pem
*.key
secret*

# Build outputs and VCS metadata
target/
.github-publish/
.git/
.gitignore

# Project docs — not needed at build time
docs/
docs-internal/
scripts/
*.md
!ATTRIBUTIONS.md
.dockerignore

# Test, fuzz, and example sources — none of these are compiled into the
# release binary, and keeping them out of the build context measurably
# shrinks the layer Docker has to upload to the daemon.
tests/
oodf-ffi/tests/
oodf-ffi/fuzz/
oodf-ffi/examples/
proptest-regressions/

# Local dev caches and IDE / agent state
tools/__pycache__/
**/__pycache__/
tools/.venv*/
*.log
.idea/
.claude/
.bees/
