{
  "Plugins": [{
    "Type": "library",
    "Name": "omni_usd_live",
    "Root": "..",
    "LibraryPath": "@LIVE_PLUGIN_LIBRARY@",
    "ResourcePath": "resources",
    "Info": {"Types": {
      "OmniUsdLiveResolver": {"bases": ["ArResolver"], "uriSchemes": ["live"]},
      "OmniUsdLiveNativeFileFormat": {
        "bases": ["SdfFileFormat"], "displayName": "Live Services",
        "extensions": ["live"], "formatId": "live", "primary": true, "target": "usd"
      }
    }}
  }]
}
