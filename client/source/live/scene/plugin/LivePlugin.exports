    omniUsdLiveCombineWithBaseUri;
    omniUsdLiveGetResultString;
    omniUsdLiveRegisterDiagnosticCallback;
    omniUsdLiveCopyDiagnostics;
    # Itanium ABI names for the dedicated public host namespace (Linux).
    # Hidden implementation classes stay hidden even when nested in this scope.
    _ZN4omni3usd4live4host*;
    _ZNK4omni3usd4live4host*;
    _ZTVN4omni3usd4live4host*;
    _ZTIN4omni3usd4live4host*;
    _ZTSN4omni3usd4live4host*;
  local: *;
};
