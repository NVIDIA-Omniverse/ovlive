# Public C ABI plus the explicitly visible host C++ facade. USD registration
# uses internal static factories and requires no additional exported symbols.
{
  global:
    omniUsdLiveGetAbiVersion;
    omniUsdLiveGetCapabilities;
    omniUsdLiveInitialize;
    omniUsdLiveShutdown;
    omniUsdLiveRegisterEndpoint;
    omniUsdLiveUnregisterEndpoint;
    omniUsdLiveGetAuthState;
    omniUsdLiveSetAccessToken;
    omniUsdLiveRegisterAuthRequiredCallback;
    omniUsdLiveFailAuthRefresh;
    omniUsdLiveListSessions;
    omniUsdLiveCreateSession;
    omniUsdLiveDeleteSession;
    omniUsdLiveJoinSession;
    omniUsdLiveLeaveSession;
    omniUsdLiveSendMessage;
    omniUsdLiveStatLayer;
    omniUsdLiveDeleteLayer;
    omniUsdLiveGetEndpointStatus;
    omniUsdLiveGetSessionStatus;
    omniUsdLiveGetLayerStatus;
    omniUsdLiveRegisterStatusCallback;
    omniUsdLiveCreateStatusObserver;
    omniUsdLiveReadStatus;
    omniUsdLiveAcknowledgeStatus;
    omniUsdLiveWaitForPendingUpdates;
    omniUsdLiveConfigureJitterReduction;
    omniUsdLiveWait;
    omniUsdLiveCancel;
    omniUsdLiveReleaseRequest;
    omniUsdLiveGetRequestStatus;
    omniUsdLiveGetRequestError;
    omniUsdLiveUnregisterCallback;
    omniUsdLiveMakeSessionUri;
