if(UNIX AND NOT APPLE)
    target_link_libraries(live_grpc_dependencies INTERFACE "-Wl,--end-group" dl)
    target_link_options(live_grpc_dependencies INTERFACE "LINKER:--exclude-libs,ALL")
endif()
if(APPLE)
    find_library(LIVE_COREFOUNDATION CoreFoundation REQUIRED)
    target_link_libraries(live_grpc_dependencies INTERFACE "${LIVE_COREFOUNDATION}")
endif()
find_package(Threads REQUIRED)
target_link_libraries(live_grpc_dependencies INTERFACE Threads::Threads)
if(WIN32)
    # The Windows system libraries of the static closure: sockets and adapters (gRPC, c-ares), crypto and the
    # certificate store (OpenSSL) and symbolization (abseil).
    target_link_libraries(live_grpc_dependencies INTERFACE ws2_32 crypt32 bcrypt iphlpapi advapi32 user32 dbghelp)
endif()
set(LIVE_PROTOC "${dep_protobuf}/bin/protoc${CMAKE_EXECUTABLE_SUFFIX}" CACHE FILEPATH "Host protoc matching pinned protobuf")
set(LIVE_GRPC_CPP_PLUGIN "${dep_grpc}/bin/grpc_cpp_plugin${CMAKE_EXECUTABLE_SUFFIX}" CACHE FILEPATH "Host gRPC generator")
if(NOT EXISTS "${LIVE_PROTOC}" OR NOT EXISTS "${LIVE_GRPC_CPP_PLUGIN}")
    message(FATAL_ERROR "Matching host protoc and gRPC generator are required")
endif()
execute_process(COMMAND "${LIVE_PROTOC}" --version OUTPUT_VARIABLE protoc_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT protoc_version STREQUAL "libprotoc 26.0")
    message(FATAL_ERROR "Expected protoc 26.0 (protobuf 5.26.0), got ${protoc_version}")
endif()
file(STRINGS "${dep_grpc}/include/grpcpp/version_info.h" grpc_version_line
    REGEX "^#define GRPC_CPP_VERSION_STRING ")
if(NOT grpc_version_line STREQUAL "#define GRPC_CPP_VERSION_STRING \"1.65.4\"")
    message(FATAL_ERROR "Expected gRPC 1.65.4 headers, got ${grpc_version_line}")
endif()
set_property(GLOBAL APPEND PROPERTY LIVE_DEPENDENCY_FILES
    "${LIVE_PROTOC}" "${LIVE_GRPC_CPP_PLUGIN}" "${dep_grpc}/include/grpcpp/version_info.h")
