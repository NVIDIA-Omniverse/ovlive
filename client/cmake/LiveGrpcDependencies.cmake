# Pinned LiveService-only dependency closure from client-library b38701a9.
# No network fetch and no dependency on the client-library checkout are implicit.
set(LIVE_DEPENDENCY_ROOT "" CACHE PATH "Directory containing pinned Packman target dependencies")
set(LIVE_DEPENDENCY_CONFIG "release" CACHE STRING "Pinned dependency configuration: debug or release")
if(NOT LIVE_DEPENDENCY_ROOT)
    message(FATAL_ERROR "LIVE_DEPENDENCY_ROOT is required for the native gRPC runtime")
endif()
if(NOT LIVE_DEPENDENCY_CONFIG MATCHES "^(debug|release)$")
    message(FATAL_ERROR "Unsupported LIVE_DEPENDENCY_CONFIG")
endif()
add_library(live_grpc_dependencies INTERFACE)
foreach(package grpc protobuf abseil re2 c-ares openssl zlib)
    set(dep_${package} "${LIVE_DEPENDENCY_ROOT}/${package}-${LIVE_DEPENDENCY_CONFIG}")
    if(NOT IS_DIRECTORY "${dep_${package}}/include")
        message(FATAL_ERROR "Missing ${package} headers in ${dep_${package}}")
    endif()
    target_include_directories(live_grpc_dependencies SYSTEM INTERFACE "${dep_${package}}/include")
endforeach()
function(live_archive package name)
    set(archive_name "${name}")
    if(package STREQUAL "protobuf" AND name STREQUAL "protobuf" AND LIVE_DEPENDENCY_CONFIG STREQUAL "debug")
        set(archive_name "protobufd")
    endif()
    if(WIN32 AND package STREQUAL "protobuf" AND name STREQUAL "protobuf")
        set(archive_name "lib${archive_name}")
    endif()
    # Windows static archives of OpenSSL keep their lib prefix, and the zlib archive has its own name.
    if(WIN32 AND package STREQUAL "openssl")
        set(archive_name "lib${name}" "${name}")
    elseif(WIN32 AND package STREQUAL "zlib")
        set(archive_name zlibstatic zlib zs z)
    endif()
    # A changed root/configuration must not retain the previous cache's archive.
    unset(archive_${package}_${name} CACHE)
    find_library(archive_${package}_${name} NAMES ${archive_name}
        PATHS "${dep_${package}}/lib" NO_DEFAULT_PATH REQUIRED)
    target_link_libraries(live_grpc_dependencies INTERFACE "${archive_${package}_${name}}")
    set_property(GLOBAL APPEND PROPERTY LIVE_DEPENDENCY_FILES "${archive_${package}_${name}}")
endfunction()
# Archive order contains cycles; group on ELF linkers, whose default single-pass
# static resolution otherwise drops symbols that later archives reference.
if(UNIX AND NOT APPLE)
    target_link_libraries(live_grpc_dependencies INTERFACE "-Wl,--start-group")
endif()
