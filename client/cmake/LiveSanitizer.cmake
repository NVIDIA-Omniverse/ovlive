set(LIVE_SANITIZER "none" CACHE STRING "Native instrumentation: none, address (ASan and UBSan) or thread (TSan)")
set_property(CACHE LIVE_SANITIZER PROPERTY STRINGS none address thread)
if(NOT LIVE_SANITIZER MATCHES "^(none|address|thread)$")
    message(FATAL_ERROR "LIVE_SANITIZER must be none, address or thread")
endif()
set(LIVE_SANITIZER_KIND "${LIVE_SANITIZER}")
if(LIVE_ENABLE_SANITIZERS) # Alias for the component workflow's address build.
    if(LIVE_SANITIZER STREQUAL "thread")
        message(FATAL_ERROR "LIVE_ENABLE_SANITIZERS selects address and conflicts with LIVE_SANITIZER=thread")
    endif()
    set(LIVE_SANITIZER_KIND address)
endif()
if(LIVE_SANITIZER_KIND STREQUAL "none")
    set(LIVE_SANITIZED OFF)
else()
    set(LIVE_SANITIZED ON)
    if(MSVC OR NOT BUILD_TESTING)
        message(FATAL_ERROR "The sanitizer lanes require GCC or Clang and BUILD_TESTING")
    endif()
endif()
set(LIVE_SANITIZER_MANIFEST_ARGS --sanitizers "$<BOOL:${LIVE_SANITIZED}>" --sanitizer "${LIVE_SANITIZER_KIND}")
# Instruments one target for the selected kind; a no-op without a sanitizer.
function(live_sanitize target scope)
    if(LIVE_SANITIZER_KIND STREQUAL "address")
        target_compile_options(${target} ${scope} -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} ${scope} -fsanitize=address,undefined)
    elseif(LIVE_SANITIZER_KIND STREQUAL "thread")
        target_compile_options(${target} ${scope} -fsanitize=thread -fno-omit-frame-pointer -g)
        if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            # GCC rejects USD's atomic_thread_fence under -Werror; TSan cannot model it.
            target_compile_options(${target} ${scope} -Wno-tsan)
        endif()
        target_link_options(${target} ${scope} -fsanitize=thread)
    endif()
endfunction()
