include_guard(GLOBAL)
set(LIVE_USD_PROFILE "stock-25.11" CACHE STRING "Explicit USD ABI: stock-25.11 or kit-25.11")
set_property(CACHE LIVE_USD_PROFILE PROPERTY STRINGS stock-25.11 kit-25.11)

# Equal USD version numbers do not imply equal namespaces or linkage. All USD
# consumers use this selector; never combine the stock and Kit libraries.
function(live_link_usd target visibility)
    if(LIVE_USD_PROFILE STREQUAL "stock-25.11")
        set(namespace pxr)
        set(internal_namespace pxrInternal_v0_25_11__pxrReserved__)
    elseif(LIVE_USD_PROFILE STREQUAL "kit-25.11")
        set(namespace ov)
        set(internal_namespace ovInternal_v0_25_11__pxrReserved__)
    else()
        message(FATAL_ERROR "Unsupported LIVE_USD_PROFILE: ${LIVE_USD_PROFILE}")
    endif()
    file(READ "${LIVE_USD_ROOT}/include/pxr/pxr.h" header)
    foreach(definition "PXR_VERSION 2511" "PXR_NS ${namespace}" "PXR_INTERNAL_NS ${internal_namespace}")
        if(NOT header MATCHES "#[ \t]*define[ \t]+${definition}[ \t]*[\r\n]")
            message(FATAL_ERROR "USD header does not match ${LIVE_USD_PROFILE}: ${definition}")
        endif()
    endforeach()
    if(NOT header MATCHES "#[ \t]*define[ \t]+PXR_PYTHON_SUPPORT_ENABLED[ \t]*[\r\n]")
        message(FATAL_ERROR "The selected USD SDK must enable Python")
    endif()
    set(libraries)
    foreach(component IN LISTS ARGN)
        if(component STREQUAL "tbb")
            set(library tbb)
        elseif(LIVE_USD_PROFILE STREQUAL "kit-25.11")
            set(library ov_25.11usd_ms)
        else()
            set(library "usd_${component}")
        endif()
        # A Windows consumer links the import library; the DLL is a runtime dependency.
        if(WIN32)
            set(path "${LIVE_USD_ROOT}/lib/${library}.lib")
        else()
            set(path "${LIVE_USD_ROOT}/lib/lib${library}${CMAKE_SHARED_LIBRARY_SUFFIX}")
        endif()
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Missing ${LIVE_USD_PROFILE} dependency: ${path}")
        endif()
        list(APPEND libraries "${path}")
    endforeach()
    list(REMOVE_DUPLICATES libraries)
    target_link_libraries(${target} ${visibility} ${libraries})
    if(WIN32)
        # oneTBB's headers request their import library by name (#pragma comment(lib)); it is in the USD lib directory.
        target_link_directories(${target} ${visibility} "${LIVE_USD_ROOT}/lib")
    endif()
endfunction()
